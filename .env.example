# MongoDB — set either one (Atlas takes precedence). Real values go in .env.local, never here.
MONGODB_ATLAS_URI=
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/painite?appName=Cluster0
MONGODB_URI=

# SMTP (Gmail by default — use an App Password, not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Painite Rare Journeys <no-reply@painitetravels.com>"
EMAIL_TO=info@painitetravels.com

NEXT_PUBLIC_SITE_URL=https://painitetravels.com

# Admin panel (/admin). Use a long, unique password.
ADMIN_EMAIL=you@painitetravels.com
ADMIN_PASSWORD=12345678
# 32+ random characters. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Image and video uploads in the admin (Cloudinary). Copy "API environment variable"
# from the Cloudinary dashboard, or set the three separate values instead.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
