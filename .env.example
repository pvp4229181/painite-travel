# MongoDB — set either one (Atlas takes precedence)
MONGODB_ATLAS_URI=
MONGODB_URI=mongodb://127.0.0.1:27017/painite

# SMTP (Gmail by default — use an App Password, not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Painite Rare Journeys <no-reply@painitetravels.com>"
EMAIL_TO=info@painitetravels.com

NEXT_PUBLIC_SITE_URL=https://painitetravels.com

# Admin panel (/admin). Use a long, unique password.
ADMIN_EMAIL=you@painitetravels.com
ADMIN_PASSWORD=12345678
# 32+ random characters. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
